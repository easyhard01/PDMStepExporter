<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- EPDM 主互操作程序集为 .NET 2.0 目标，.NET 4.x 独立程序需要此设置 -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- 上次使用的 PDM 库名称（留空则不预选） -->
    <add key="VaultName" value="" />
    <!-- 与 PDM 库中数据卡变量名一致；如不一致请修改 -->
    <add key="VariableCode" value="物料编码" />
    <add key="VariableSpec" value="规格型号" />
    <!-- 默认输出目录（留空则导出到 桌面\PDM_STEP导出） -->
    <add key="OutputDir" value="" />
    <add key="UseInputName" value="False" />
    <add key="FuzzyMatch" value="False" />
    <add key="Recursive" value="True" />
    <add key="GetLatest" value="True" />
    <add key="CloseSwAfterExport" value="True" />
    <add key="FirstOnly" value="True" />
    <!-- 0=物料编码 1=规格型号 2=自动判断 -->
    <add key="SearchMode" value="2" />
  </appSettings>
</configuration>
